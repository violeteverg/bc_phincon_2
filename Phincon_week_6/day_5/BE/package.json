{
  "name": "be",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npm run serve",
    "dev": "concurrently \"npm run build:watch\" \"npm run copy-files\" \"npm run serve:watch\"",
    "copy-files": "cp -r ./views ./dist/",
    "serve": "node dist/index.js",
    "serve:watch": "nodemon dist/index.js",
    "build": "tsc",
    "build:watch": "tsc -w",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed:generate": "npx sequelize-cli seed:generate --name",
    "seed:run": "npx sequelize-cli db:seed --seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@sequelize/core": "^7.0.0-alpha.42",
    "@types/express": "^5.0.0",
    "body-parser": "^1.20.3",
    "concurrently": "^9.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "faker": "^6.6.6",
    "nodemon": "^3.1.7",
    "pg": "^8.13.0",
    "sequelize": "^6.37.4",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.3",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.7.6",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
